{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=news_summarizer;Username=postgres;Password=postgres"
  },
  "NewsFetching": {
    "Provider": "Mock"
  },
  "AiProvider": {
    "Provider": "Mock",
    "BaseUrl": "https://ai.api.cloud.yandex.net/v1",
    "ApiKey": "",
    "FolderId": "",
    "Model": "yandexgpt/rc",
    "PromptVersion": "v1",
    "MaxOutputTokens": 800,
    "Temperature": 0.2,
    "RequestTimeoutSeconds": 60
  },
  "Telegram": {
    "BotToken": "",
    "PollingEnabled": false,
    "PollingTimeoutSeconds": 25,
    "SendChunkLength": 3800
  },
  "WorkerPipeline": {
    "Enabled": true,
    "RunOnStartup": true,
    "LoopDelaySeconds": 30,
    "StopOnFatalError": false,
    "AnalyzeArticlesLimit": 20,
    "SendPendingNotificationsLimit": 50,
    "Jobs": {
      "FetchNews": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 300
      },
      "AnalyzeArticles": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 120
      },
      "BuildDailyDigests": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 900
      },
      "BuildOpportunityDigests": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 900
      },
      "SendUrgentNotifications": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 180
      },
      "SendPendingNotifications": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 60
      },
      "CleanupExpiredData": {
        "Enabled": true,
        "RunOnStartup": true,
        "IntervalSeconds": 3600
      }
    }
  }
}
